        </mxCell>
        <mxCell id="uc3" value="Valider / corriger la liste des présents" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="210" width="280" height="44" as="geometry" />
        </mxCell>
        <mxCell id="uc4" value="Consulter les rapports d'assiduité" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="270" width="280" height="44" as="geometry" />
        </mxCell>
        <mxCell id="uc5" value="Exporter les rapports (Excel / PDF)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="330" width="280" height="44" as="geometry" />
        </mxCell>
        <mxCell id="uc6" value="Gérer les étudiants &amp; enrôler les photos" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="390" width="280" height="44" as="geometry" />
        </mxCell>
        <mxCell id="uc7" value="Gérer classes / modules / séances" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="450" width="280" height="44" as="geometry" />
        </mxCell>
        <mxCell id="uc8" value="Consulter mon assiduité" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="510" width="280" height="44" as="geometry" />
