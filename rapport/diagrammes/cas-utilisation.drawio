        <mxCell id="uc9" value="Recevoir une alerte d'absentéisme" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="570" width="280" height="44" as="geometry" />
