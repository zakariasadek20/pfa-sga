        <!-- Associations Enseignant -->
        <mxCell id="a1" style="endArrow=none;html=1;" edge="1" parent="1" source="ens" target="uc1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="endArrow=none;html=1;" edge="1" parent="1" source="ens" target="uc2"><mxGeometry relative="1" as="geometry" /></mxCell>
